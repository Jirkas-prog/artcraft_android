+// Set only by the Android shell; desktop mouse/trackpad preferences stay unchanged.
+pub(crate) fn android_finger_navigation(ctx: &egui::Context) -> bool {
+    ctx.data(|d| d.get_temp::<bool>(egui::Id::new("craft.android.finger-navigation")).unwrap_or(false))
+}
